__pycache__/
*.py[cod]
output.csv
ramulator.out
ramulator2/build/
ramulator2/log/

# one-off local backup (2.6 GB), never track
ramulator2.local_backup_0821/

# --- raw sim output is local-only (dag_*.json event traces + logs, incl. the
#     archived pre-unify results and the new sweep runs); see
#     docs/RAW_DATA_MANIFEST.md. Track only output/analysis/. ---
/output/*
!/output/analysis/
/output/analysis/.digest_cache/
# The orchestration and the verification harness are SCRIPTS, not run data
# (author's ruling 2026-08-31): the governor carries a measured memory/time
# model and the verify harness is the reusable bit-identity method.  Their
# outputs stay local, same as every other raw run.
!/output/_orch2/
/output/_orch2/__pycache__/
/output/_orch2/CURRENT_ROOT
/output/_orch2/*.bak
!/output/_verify/
/output/_verify/before/
/output/_verify/after/
/output/_verify/after2/
/output/_verify/pristine/
/output/_verify/*.json
/output/_verify/*.bak

# cppcore build artifact (see docs/sessions/2026-08-30.md §4)
src/cppcore/*.so
/output/analysis/.extract_cache.pkl

# --- analytic-PIM experiment (experiments/analytic_a1_0902) ---
# Per-cell workload reports are 4-10 MB of raw run output; the same rule as
# dag_*.json applies, so the EXTRACTED numbers go in instead (matrix_2x2.csv,
# llama3_8b/cold_cache_2x2.csv, error_scaling/*.csv, RESULTS.md).
# The Ramulator signature CACHES are ground truth for the calibration and DO go
# in -- they are the only thing that makes timing_models.json reproducible.
experiments/analytic_a1_0902/**/report.json
experiments/analytic_a1_0902/llama3_8b/*/analytic.json
experiments/analytic_a1_0902/llama3_8b/*/ramulator.json
experiments/analytic_a1_0902/**/ramulator2/ramulator2
experiments/analytic_a1_0902/**/ramulator2/trace_gen
experiments/analytic_a1_0902/**/*.ramulator2/
experiments/analytic_a1_0902/**/*.trace
experiments/analytic_a1_0902/**/*.yaml
experiments/analytic_a1_0902/**/*.out
experiments/analytic_a1_0902/slurm_*.log
experiments/analytic_a1_0902/slurm_existing/
experiments/analytic_a1_0902/slurm_wltiny/
experiments/analytic_a1_0902/a1_llama7b_*.json
experiments/analytic_a1_0902/a1_llama7b_*.log
experiments/analytic_a1_0902/a1_holdout_*.json
experiments/analytic_a1_0902/timing_models_rag.json
experiments/analytic_a1_0902/__pycache__/
