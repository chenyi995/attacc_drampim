digraph DiMap {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.45",
         splines=polyline, fontname="DejaVu Sans", fontsize=20, labelloc=t,
         label="KVChime: D_i Map Microarchitecture\n", outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#F2F4F6", color="#506477",
        penwidth=1.3, fontname="DejaVu Sans", fontsize=12, margin="0.17,0.12"];
  edge [color="#506477", penwidth=1.3, arrowsize=0.7,
        fontname="DejaVu Sans", fontsize=10];

  update [label="Metadata Write\nword index + replacement mask"];
  bitmap [label="Bitmap Table\nD_i replacement masks\n128 words x 16 bits, register array", fillcolor="#DCEEDC"];
  update -> bitmap [label="write enable"];
  flookup [label="Bitmap Lookup\nfwd_word_idx", group="fwd"];
  rlookup [label="Bitmap Lookup\nrev_word_idx", group="rev"];
  bitmap -> flookup [label="forward read"];
  bitmap -> rlookup [label="reverse read"];
  {rank=same; flookup; rlookup;}

  prefix [label="Exclusive Prefix Sum\nrank[l] = sum of mask bits before l", fillcolor="#DCEAF7", group="fwd"];
  compact [label="Compact Repair Scores\ndiff_stream[r]", fillcolor="#F9DFC6"];
  indexmux [label="Indexed Multiplexer\nrepair_lane[l] = diff_stream[rank[l]]", fillcolor="#DCEAF7", group="fwd"];
  master [label="Master Scores\nmaster_score[l]", fillcolor="#DCEAF7"];
  selectmux [label="2:1 Multiplexer\nmask[l] selects repair or master", fillcolor="#DCEAF7", group="fwd"];
  corrected [label="Corrected Score Word\noriginal logical lanes\nto one global softmax per query", fillcolor="#DCEEDC", group="fwd"];
  flookup -> prefix [label="mask bits"];
  prefix -> indexmux [style=dashed, label="select index"];
  compact -> indexmux [label="data"];
  indexmux -> selectmux [label="repair data"];
  master -> selectmux [label="master data"];
  flookup -> selectmux [style=dashed, label="mask", constraint=false];
  selectmux -> corrected;
  {rank=same; prefix; compact;}
  {rank=same; indexmux; master;}

  prob [label="Probability Word\nP[l] from global softmax", fillcolor="#DCEEDC", group="prob"];
  gates [label="2:1 Multiplexers / Mask Gating\nP_master[l] = mask[l] ? 0 : P[l]\nP_private[l] = mask[l] ? P[l] : 0", fillcolor="#F9DFC6", group="rev"];
  pmaster [label="Master Probability Lanes\nreplaced lanes are zero", fillcolor="#DCEAF7"];
  pprivate [label="Private Probability Lanes\nunreplaced lanes are zero", fillcolor="#F9DFC6"];
  rlookup -> gates [style=dashed, label="same replacement mask"];
  prob -> gates [label="data"];
  gates -> pmaster;
  gates -> pprivate;
  {rank=same; prefix; prob;}
  {rank=same; indexmux; gates;}
  {rank=same; corrected; pmaster; pprivate;}

  note [shape=note, fillcolor="#F8FAFB", color="#A6B4BE", fontsize=10,
        label="One active map; request switching is external.\nForward rank is local to one word. Reverse outputs retain logical lanes.\nNo compact gather and no dedicated private channel are implied."];
  corrected -> note [style=invis];
  pmaster -> note [style=invis];
  pprivate -> note [style=invis];
}
