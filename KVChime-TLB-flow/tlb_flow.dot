digraph KVChimeTLB {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.55", ranksep="0.42",
         splines=polyline, fontname="DejaVu Sans", fontsize=20, labelloc=t,
         label="KVChime: KV Address Translation\n", outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#F2F4F6", color="#506477",
        penwidth=1.3, fontname="DejaVu Sans", fontsize=13, margin="0.18,0.12"];
  edge [color="#506477", penwidth=1.4, arrowsize=0.75,
        fontname="DejaVu Sans", fontsize=11];

  request [label="Translation Request\ncontext, layer, logical position\nselected object + packed row", fillcolor="#F2F4F6", group="fast"];

  lookup [label="Range TLB Lookup\nTag Match + Range Check", fillcolor="#DCEAF7", group="fast"];
  hit [shape=diamond, label="Hit?", width=0.85, height=0.65, margin="0.04", group="fast"];
  generation [label="Physical Address Generation\nobject base + physical row offset", fillcolor="#DCEAF7", group="fast"];
  lookup -> hit;
  hit -> generation [label="  Yes"];

  walker [label="Range Table Walker\ndescriptor lookup", fillcolor="#F9DFC6", group="miss"];
  refill [label="TLB Refill\ninstall descriptor; retry", fillcolor="#F9DFC6", group="miss"];
  table [shape=cylinder, label="Range Table\nsegment descriptors in memory", fillcolor="#DCEEDC", group="table"];
  controller [label="Memory Controller\nphysical-address decoding", group="fast"];
  memory [shape=plain, group="fast", label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#889BA9">
      <TR><TD COLSPAN="2"><B>HBM address space</B></TD></TR>
      <TR><TD BGCOLOR="#DCEAF7">Shared master<BR/>base Bm</TD><TD BGCOLOR="#F9DFC6">Private diff / tail<BR/>base Bd / Bt</TD></TR>
      <TR><TD COLSPAN="2">Same channel allowed; disjoint physical allocations</TD></TR>
    </TABLE>
  >];
  view [shape=note, style=filled, fillcolor="#F8FAFB", color="#A6B4BE", fontsize=11,
        label="Outside the TLB\nRequest-view metadata supplies:\nselected segment, packed row, logical slot.\nRepair retains the replaced logical slot."];

  {rank=same; request; view;}
  {rank=same; hit; walker; table;}
  {rank=same; generation; refill;}
  request -> lookup;
  view -> request [style=dashed, constraint=false, label="resolved reference"];
  hit -> walker [label="No", constraint=false];
  walker -> table [dir=both, label="read / response", constraint=false];
  walker -> refill [label="mapping found"];
  refill -> lookup [style=dashed, color="#B87839", label="refill + retry", constraint=false];
  generation -> controller;
  controller -> memory;
}
